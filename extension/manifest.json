{
  "manifest_version": 3,
  "name": "Job Tracker — auto-mark applied",
  "description": "Detects ATS application confirmation pages and marks the matching job as applied in your tracker.",
  "version": "0.1.0",
  "icons": { "128": "icon.png" },
  "action": {
    "default_title": "Job Tracker",
    "default_popup": "popup.html",
    "default_icon": { "128": "icon.png" }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "notifications"],
  "host_permissions": [
    "https://jobs.ashbyhq.com/*",
    "https://*.ashbyhq.com/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.lever.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://jobs.ashbyhq.com/*",
        "https://*.ashbyhq.com/*",
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
